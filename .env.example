# 앱
NODE_ENV=development
PORT=3000
# 프록시(nginx/ALB) 뒤에 있을 때 신뢰할 홉 수. 직접 노출이면 0
TRUST_PROXY=0

# 어드민 프론트 오리진. 콤마 구분, 비우면 CORS 비활성
CORS_ORIGINS=http://localhost:5173

# 전역 요청 제한 (로그인은 별도로 1초 2회)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# DB (docker compose 에서는 DB_HOST 가 db 로 덮어써진다)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=coin_sweep
DB_LOGGING=false
# 호스트에서 접속할 때 쓸 포트 (compose 전용)
DB_EXPOSED_PORT=5432

# 세션 (16자 이상, 운영에서는 반드시 교체)
SESSION_SECRET=dev-session-secret-change-me
SESSION_NAME=sid
SESSION_MAX_AGE=86400000
# HTTPS 뒤에서만 true
SESSION_SECURE=false
# 프론트가 다른 도메인이면 none (이때 SESSION_SECURE=true 필수)
SESSION_SAME_SITE=lax
# 만료 세션 청소 주기(ms). 세션은 프로세스 메모리에만 저장된다.
SESSION_PRUNE_INTERVAL=3600000

# Swagger (미지정 시 production 이면 off)
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# db:seed 커맨드가 만드는 최초 super_admin 계정
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
