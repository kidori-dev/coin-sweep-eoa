# ============================================================
# 앱
# ============================================================
NODE_ENV=development
PORT=3000
# 프록시(nginx/ALB) 뒤에 있을 때 신뢰할 홉 수. 직접 노출이면 0
TRUST_PROXY=0

# ============================================================
# DB (docker compose 에서는 DB_HOST 가 db 로 덮어써진다)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=coin_sweep
DB_LOGGING=false
# 호스트에서 접속할 때 쓸 포트 (compose 전용)
DB_EXPOSED_PORT=5432

# ============================================================
# 어드민 세션 (세션은 프로세스 메모리에 저장된다)
# ============================================================
# 16자 이상, 운영에서는 반드시 교체
SESSION_SECRET=dev-session-secret-change-me
SESSION_NAME=sid
SESSION_MAX_AGE=86400000
# HTTPS 뒤에서만 true
SESSION_SECURE=false
# 프론트가 다른 도메인이면 none (이때 SESSION_SECURE=true 필수)
SESSION_SAME_SITE=lax
# 만료 세션 청소 주기(ms)
SESSION_PRUNE_INTERVAL=3600000

# db:seed 커맨드가 만드는 최초 super_admin 계정
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# ============================================================
# 보안
# ============================================================
# 어드민 프론트 오리진. 콤마 구분, 비우면 CORS 비활성
CORS_ORIGINS=http://localhost:5173
# 전역 요청 제한 (로그인은 코드에서 1초 2회로 따로 건다)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# 미지정 시 production 이면 자동으로 off
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ============================================================
# TRON 연결
# ============================================================
TRON_FULL_HOST=https://nile.trongrid.io
# TronGrid API key (없어도 동작하나 rate limit 이 낮다)
TRON_API_KEY=

# ============================================================
# TRON 지갑 (메인지갑 + 모든 입금주소가 여기서 파생된다)
# ============================================================
# 절대 유출 금지. 잃어버리면 모든 입금주소 자금을 복구할 수 없다
TRON_MNEMONIC=<12 words mnemonic - 반드시 직접 생성해서 넣으세요>
TRON_HD_PATH=m/44'/195'/0'/0
# 집금 목적지가 되는 메인지갑의 파생 인덱스. 입금주소는 그다음부터 발급된다
TRON_MAIN_INDEX=0

# ============================================================
# 자동 집금 (tron:sweep / POST /api/sweeps)
# ============================================================
# 자동 집금은 이 컨트랙트 하나만 대상으로 한다. TRX 나 다른 TRC20 은 건드리지 않는다
# (Nile faucet 이 주는 테스트 USDT)
TRON_TOKEN_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
# 이 금액 미만이면 집금하지 않는다 (최소 단위, USDT decimals=6 → 5000000 = 5 USDT)
TRON_MIN_SWEEP_TOKEN=5000000

# ============================================================
# TRON 수수료 (입금주소는 TRX 가 없으므로 집금 때마다 대신 내줘야 한다)
# ============================================================
# delegate = 메인지갑이 스테이킹한 energy 를 빌려줬다 회수 (TRX 가 잠기기만 함)
# transfer = 메인지갑이 입금주소로 TRX 를 보내 태우게 함
TRON_FEE_STRATEGY=delegate
# 집금 1건에 필요하다고 보는 energy. 위임액은 여기서 자동 계산된다 (Nile USDT 실측 14,650)
TRON_DELEGATE_ENERGY=20000
# 위임이 거부되면 transfer 전략으로 자동 대체
TRON_FEE_FALLBACK=true
# transfer 전략에서 1건당 보낼 TRX (SUN)
TRON_GAS_TOPUP_SUN=15000000
# 무료 대역폭이 모자란 입금주소에 채워줄 TRX (SUN). TRC20 전송은 bandwidth 도 쓴다
TRON_BANDWIDTH_TOPUP_SUN=500000
# 미활성 입금주소를 활성화할 때 보낼 TRX (SUN). 0.1 TRX 로 활성화되는 것을 실측 확인
# 별도로 계정 생성 수수료 1 TRX 가 메인지갑에서 소각된다 (고정, 줄일 수 없음)
TRON_ACTIVATION_SUN=100000
# 스마트컨트랙트 호출 수수료 상한 (SUN)
TRON_FEE_LIMIT_SUN=100000000
